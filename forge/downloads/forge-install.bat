@echo off
setlocal

:: forge-install.bat -- Self-contained FORGE CLI installer for Windows
:: Embeds forge-install.ps1 content and runs it via PowerShell.
:: Users who cannot execute .ps1 files directly can run this instead.
:: The bootstrap is base64-encoded to avoid all cmd quoting issues.

set "FORGE_BAT_PATH=%~f0"
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

endlocal & exit /b %ERRORLEVEL%

##PS1_START##
<#
.SYNOPSIS
    FORGE CLI Installer v1.1.10
    Self-contained -- no network calls, no git clone needed.

.EXAMPLE
    .\forge-install.ps1

.EXAMPLE
    .\forge-install.ps1 -Dir "C:\tools\forge-cli"

.EXAMPLE
    .\forge-install.ps1 -Update
#>

param(
    [string]$Dir    = "$HOME\forge-cli",
    [switch]$Update,
    [switch]$Verbose
)

$ForgeVersion = "1.1.10"
$InstallDir   = $Dir
$ErrorActionPreference = 'Stop'

function Write-ForgeStatus {
    param([string]$Message, [string]$Type = 'Info')
    $colors   = @{ Info='Cyan'; Success='Green'; Warning='Yellow'; Error='Red' }
    $prefixes = @{ Info='[i]'; Success='[+]'; Warning='[!]'; Error='[-]' }
    Write-Host $prefixes[$Type] -ForegroundColor $colors[$Type] -NoNewline
    Write-Host " $Message"
}

Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "FORGE CLI Installer v$ForgeVersion" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host ""

if (Test-Path $InstallDir) {
    Write-ForgeStatus "FORGE CLI already exists at: $InstallDir" -Type 'Warning'
    Write-ForgeStatus "Removing existing installation and reinstalling..." -Type 'Info'
    Remove-Item $InstallDir -Recurse -Force
}

Write-ForgeStatus "Installing to: $InstallDir" -Type 'Info'

$TempDir = Join-Path ([System.IO.Path]::GetTempPath()) "forge-install-$([System.Guid]::NewGuid().ToString('N').Substring(0,8))"
New-Item -ItemType Directory -Path $TempDir | Out-Null

try {
    Write-ForgeStatus "Extracting files..." -Type 'Info'

    $Payload     = ""
    $ArchivePath = Join-Path $TempDir "forge_cli.tar.gz"
    $bytes       = [System.Convert]::FromBase64String($Payload)
    [System.IO.File]::WriteAllBytes($ArchivePath, $bytes)

    if ($Verbose) { Write-Host "    Archive: $($bytes.Length) bytes" -ForegroundColor DarkGray }

    $tarAvailable = $null -ne (Get-Command tar -ErrorAction SilentlyContinue)
    if ($tarAvailable) {
        tar -xzf "$ArchivePath" -C "$TempDir"
    } else {
        # .NET GZip fallback then tar for the inner .tar
        $tarPath  = Join-Path $TempDir "forge_cli.tar"
        $gzStream = [System.IO.File]::OpenRead($ArchivePath)
        $tarStream= [System.IO.File]::Create($tarPath)
        $gz       = New-Object System.IO.Compression.GZipStream($gzStream, [System.IO.Compression.CompressionMode]::Decompress)
        $gz.CopyTo($tarStream)
        $gz.Close(); $tarStream.Close(); $gzStream.Close()
        tar -xf "$tarPath" -C "$TempDir"
    }

    $ExtractedCli = Join-Path $TempDir "forge_cli"
    if (-not (Test-Path $ExtractedCli)) {
        throw "Extraction failed -- forge_cli/ not found in archive"
    }

    Move-Item $ExtractedCli $InstallDir

    # Strip carriage returns from shell scripts in case they were bundled on Windows
    $shFiles = Get-ChildItem -Path $InstallDir -Filter "*.sh"
    $shFiles += Get-Item -Path (Join-Path $InstallDir "forge") -ErrorAction SilentlyContinue
    foreach ($f in $shFiles) {
        if ($f -and (Test-Path $f.FullName)) {
            $content = [System.IO.File]::ReadAllText($f.FullName, [System.Text.Encoding]::UTF8)
            $content = $content -replace "", ""
            [System.IO.File]::WriteAllText($f.FullName, $content, [System.Text.Encoding]::UTF8)
        }
    }

    # Ensure .bat and .ps1 files have CRLF line endings (required for Windows)
    # Use UTF-8 without BOM for .bat files (BOM breaks @echo off)
    $utf8NoBom = [System.Text.UTF8Encoding]::new($false)
    $winFiles = Get-ChildItem -Path $InstallDir -Include "*.bat","*.ps1" -Recurse
    foreach ($f in $winFiles) {
        if ($f -and (Test-Path $f.FullName)) {
            # Read as bytes to detect and strip BOM
            $bytes = [System.IO.File]::ReadAllBytes($f.FullName)
            $startIndex = 0
            # Check for UTF-8 BOM (EF BB BF)
            if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
                $startIndex = 3
            }
            $content = $utf8NoBom.GetString($bytes, $startIndex, $bytes.Length - $startIndex)
            # Normalize to LF first, then convert to CRLF
            $content = $content -replace "
", "
"
            $content = $content -replace "
", "
"
            [System.IO.File]::WriteAllText($f.FullName, $content, $utf8NoBom)
        }
    }

    Write-ForgeStatus "Files installed to: $InstallDir" -Type 'Success'
    Write-Host ""

    # Add to PATH
    $UserPath = [Environment]::GetEnvironmentVariable('Path', 'User')
    if ($UserPath -notlike "*$InstallDir*") {
        try {
            [Environment]::SetEnvironmentVariable('Path', $UserPath.TrimEnd(';') + ";$InstallDir", 'User')
            Write-ForgeStatus "Added to user PATH" -Type 'Success'
        } catch {
            Write-ForgeStatus "Could not update PATH: $($_.Exception.Message)" -Type 'Warning'
            Write-ForgeStatus "Add manually: $InstallDir" -Type 'Warning'
        }
    } else {
        Write-ForgeStatus "Already in PATH" -Type 'Info'
    }

    # Execution policy
    try {
        $policy = Get-ExecutionPolicy -Scope CurrentUser
        if ($policy -eq 'Restricted' -or $policy -eq 'Undefined') {
            Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned -Force
            Write-ForgeStatus "Set execution policy to RemoteSigned" -Type 'Success'
        }
    } catch {
        Write-ForgeStatus "Could not set execution policy (may be managed by group policy)" -Type 'Warning'
    }

    Write-Host ""
    Write-Host "========================================" -ForegroundColor Cyan
    Write-ForgeStatus "FORGE CLI v$ForgeVersion installed!" -Type 'Success'
    Write-Host ""
    Write-Host "Next steps:"
    Write-Host "  1. Restart your terminal"
    Write-Host "  2. Try it:"
    Write-Host "     forge help"
    Write-Host "     forge out"
    Write-Host "     forge in"
    Write-Host ""
    Write-Host "# PIXI INSTALL (coming soon)" -ForegroundColor DarkGray
    Write-Host "# Pixi is a fast package manager used in FDA FORGE workflows." -ForegroundColor DarkGray
    Write-Host "# A future version of this installer will offer to install pixi." -ForegroundColor DarkGray
    Write-Host "# For now: https://pixi.sh" -ForegroundColor DarkGray
    Write-Host ""
    Write-Host "========================================" -ForegroundColor Cyan
    Write-Host ""

} finally {
    if (Test-Path $TempDir) {
        Remove-Item $TempDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}
##PS1_END##
